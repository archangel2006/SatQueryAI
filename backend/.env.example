# Postgres (async SQLAlchemy). For local file DB instead:
# DATABASE_URL=sqlite+aiosqlite:///./satquery.db
# Local Docker: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=satquery -e POSTGRES_DB=satquery postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:satquery@127.0.0.1:5432/satquery

# Clerk JWT verification (Dashboard → API Keys / JWT)
# JWKS: https://<your-clerk-domain>/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional if you configure an API audience in Clerk
CLERK_AUDIENCE=

# Google Cloud (GCS + Vertex Gemini)
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET=satquery-uploads
# Local only — on Cloud Run use workload identity instead
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Gemini — prefer API key (AI Studio). Vertex uses SA credentials if key is empty.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
CHAT_CONTEXT_MESSAGE_LIMIT=20

# CORS (comma-separated). Defaults to localhost Vite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Checkpoints
CHANGE_CHECKPOINT_PATH=checkpoints/best_model.pth

# Testing / local without GCP: leave GCS_BUCKET empty to use in-memory storage.
# Auth can be bypassed in tests via dependency overrides.
